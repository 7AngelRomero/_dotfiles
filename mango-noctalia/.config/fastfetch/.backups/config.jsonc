// Inspired by Catnap
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-icat",
        "source": "/home/justblind-nsx/Pictures/Auto posting/tokyo-xtreme-racer-s2000.gif",
        "width": 65,
        "height": 30,
        "padding": {
            "top": 2,
            "left": 1,
            "right": 5,
            "buttom": 2,
            }
        },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#90}󰌢 Host    {#keys}│",
            "type": "host"
        },
        {
            "key": "│ {#31}󰍛 Cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#32}󰾲 Gpu     {#keys}│",
            "type": "gpu"
        },
        {
            "key": "│ {#33}󰉉 Disk    {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#34} Memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {#36}󰍹 Display {#keys}│",
            "type": "display",
            "compactType": "original-with-refresh-rate"
        },
        {
            "key": "│ {#37} Audio   {#keys}│",
            "type": "sound",
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#36} Shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {#35} Term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#34} Font    {#keys}│",
            "type": "terminalfont",
        },
        {
            "key": "│ {#33}󰧨 Login   {#keys}│",
            "type": "lm",
        },
        {
            "key": "│ {#32}󰇄 Desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#31} WM      {#keys}│",
            "type": "wm",
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#34} User    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {#35}󰇅 Hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {#36}{icon} Distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {#37} Kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#38}󰏖 Pkgs    {#keys}│",
            "type": "packages"
        },
        {
            "key": "│ {#37}󰅐 Uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
